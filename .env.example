# Copy this file to .env before running `docker compose up`.
#
# docker-compose.yml uses it for two things: ${VAR} interpolation of the MongoDB
# credentials, and as the environment for the backend + resume-worker services
# (via env_file). Compose fails fast with "MONGO_USER not set" if this file is
# missing.

# --- MongoDB (containerized by docker-compose) ---
MONGO_USER=admin
MONGO_PASSWORD=change_me
MONGO_DB=resume_screener
MONGO_URI=mongodb://admin:change_me@mongo:27017/resume_screener?authSource=admin

# --- Backend ---
PORT=5000
# With NODE_ENV=production the backend refuses to start unless JWT_SECRET and
# MONGO_URI are set (see src/config/env.ts).
NODE_ENV=production
# Replace with a long random string before deploying anywhere real.
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# The auth cookie's `Secure` flag is derived from the request protocol
# (req.secure / X-Forwarded-Proto), so serving over http://localhost works even
# with NODE_ENV=production. Set this only to force an explicit value:
# COOKIE_SECURE=true

# --- ML service (internal DNS name inside the compose network) ---
ML_SERVICE_URL=http://ml-service:8000

# --- Frontend ---
# Used by Vite at build time. `/api` is proxied to the backend by nginx
# (frontend/nginx.conf) and by the Vite dev server (frontend/vite.config.ts).
VITE_API_BASE_URL=/api
