# Backend environment for running outside Docker (npm run dev / npm run worker).
# Copy to backend/.env. Set DATABASE_URL to your local PostgreSQL credentials.
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/resume_screener
# Use the provider's Redis TCP URI for BullMQ (for example rediss://...); REST URLs are not supported.
REDIS_URL=redis://localhost:6379
ML_SERVICE_URL=http://localhost:8000

# How many resumes the worker scores in parallel.
RESUME_QUEUE_CONCURRENCY=3

PORT=5000
NODE_ENV=development
JWT_SECRET=dev_secret_change_me
JWT_EXPIRES_IN=7d

# Where uploaded PDFs/DOCX files are written (relative to the process cwd).
UPLOAD_DIR=./uploads

# Only needed when TLS is terminated by a proxy that does not forward
# X-Forwarded-Proto. Unset = the auth cookie's Secure flag follows the request.
# COOKIE_SECURE=false
