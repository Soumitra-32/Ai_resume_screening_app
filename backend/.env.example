# Backend environment for running OUTSIDE docker (npm run dev / npm run worker).
# Copy to backend/.env. Inside docker-compose the root .env is used instead.
MONGO_URI=mongodb://localhost:27017/resume_screener
REDIS_URL=redis://localhost:6379
ML_SERVICE_URL=http://localhost:8000

# How many resumes the worker scores in parallel.
RESUME_QUEUE_CONCURRENCY=3

PORT=5000
NODE_ENV=development
JWT_SECRET=dev_secret_change_me
JWT_EXPIRES_IN=7d

# Where uploaded PDFs/DOCX files are written (relative to the process cwd).
UPLOAD_DIR=./uploads

# Only needed when TLS is terminated by a proxy that does not forward
# X-Forwarded-Proto. Unset = the auth cookie's Secure flag follows the request.
# COOKIE_SECURE=false
