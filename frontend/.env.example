# Frontend (Vite) environment. Copy to `.env.local` to override.
#
# This file used to hold MongoDB/JWT/ML secrets, which are backend-only — they
# belong in the repository root .env (see ../../.env.example). Vite only exposes
# variables prefixed with VITE_ and would never have read them anyway.

# The API prefix the browser calls. Keep it as /api: the Vite dev server
# proxies /api to the backend (vite.config.ts) and nginx does the same in the
# Docker image, so the SPA and the API stay same-origin and the auth cookie
# keeps working.
VITE_API_BASE_URL=/api

# Optional: where `npm run dev` proxies /api (defaults to http://localhost:5000)
# VITE_API_PROXY_TARGET=http://localhost:5000
